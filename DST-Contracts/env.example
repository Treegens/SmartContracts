# LayerZero V2 ONFT Configuration
# Copy this file to .env and fill in your values

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimistic_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
SNOWTRACE_API_KEY=your_snowtrace_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# RPC API keys (optional, can be set in foundry.toml)
RPC_API_KEY=your_rpc_api_key

# Example contract addresses (replace with your deployed addresses)
# ONFT721 Contract on Sepolia
ONFT_CONTRACT_SEPOLIA=0x1234567890123456789012345678901234567890

# ONFT721 Contract on Base Sepolia
ONFT_CONTRACT_BASE_SEPOLIA=0x5678901234567890123456789012345678901234

# ONFT721Adapter Contract on Sepolia
ONFT_ADAPTER_SEPOLIA=0x9012345678901234567890123456789012345678

# Existing ERC721 Token Address (for adapter)
TOKEN_ADDRESS=0x3456789012345678901234567890123456789012

# LayerZero Endpoint Addresses
LZ_ENDPOINT_MAINNET=0x1a44076050125825900e736c501f859c50fE728c
LZ_ENDPOINT_TESTNET=0x6EDCE65403992e310A62460808c4b910D972f10f

# Security Configuration
SEND_CONFIRMATIONS=15
RECEIVE_CONFIRMATIONS=15
SEND_DVN_COUNT=1
RECEIVE_DVN_COUNT=1
GRACE_PERIOD=0

# Message Execution Options
GAS_LIMIT=100000
MSG_VALUE=0
MAX_MESSAGE_SIZE=10000

# DVN Addresses (comma-separated)
SEND_DVNS=0x0000000000000000000000000000000000000000
SEND_OPTIONAL_DVNS=
RECEIVE_DVNS=0x0000000000000000000000000000000000000000
RECEIVE_OPTIONAL_DVNS=

# Library Addresses (optional, will use defaults if not set)
SEND_LIBRARY=
RECEIVE_LIBRARY=
EXECUTOR=
