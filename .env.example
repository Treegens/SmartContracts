# Template for Hardhat environment variables.
# Copy to `.env` and fill in values before deploying.

# Network / deployer (see `hardhat.config.ts` — `__RUNTIME_DEPLOYER_PRIVATE_KEY` or network accounts)
ALCHEMY_API_KEY=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- MGRO (`constructor(address _admin)`) ---
# Receives DEFAULT_ADMIN_ROLE; can grant MINTER_ROLE after deploy.
# Defaults to the deployer account when unset.
MGRO_ADMIN_ADDRESS=

# --- TGNVault (`constructor(address _admin, address _tgn, uint8 _slashingPercent, address _treasury)`) ---
# Admin receives DEFAULT_ADMIN_ROLE; can grant SLASHER_ROLE after deploy.
# Unset addresses default to the deployer account.
TGN_VAULT_ADMIN_ADDRESS=
TGN_TOKEN_ADDRESS=0xA10336e3e0ee9CC81397db91aC585BA32460Cdcf
TGN_VAULT_SLASHING_PERCENT=10
TGN_VAULT_TREASURY_ADDRESS=
