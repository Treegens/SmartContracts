{
  "name": "contracts-starter",
  "version": "1.0.0",
  "description": "Template for contract projects.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "verify:diamond": "hardhat verify --network $NETWORK $DIAMOND_ADDRESS",
    "verify:facet": "hardhat verify --network $NETWORK $FACET_ADDRESS",
    "verify:mgro": "hardhat verify --network $NETWORK $MGRO_ADDRESS $LZ_ENDPOINT $DEPLOYER",
    "verify:receiver": "hardhat verify --network $NETWORK $CELO_RECEIVER_ADDRESS $LZ_ENDPOINT $DEPLOYER $MGRO_ADDRESS",
    "verify:messenger": "hardhat verify --network $NETWORK $BASE_MESSENGER_ADDRESS $LZ_ENDPOINT $DEPLOYER $DIAMOND_ADDRESS"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mudgen/contracts-starter.git"
  },
  "author": "Nick Mudge",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mudgen/contracts-starter/issues"
  },
  "homepage": "https://github.com/mudgen/contracts-starter#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.2",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "chai": "^4.3.4",
    "dotenv": "^8.6.0",
    "ethereum-waffle": "^3.4.0",
    "ethers": "^5.4.1",
    "hardhat": "^2.4.1",
    "prettier": "^2.3.2",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "standard": "^16.0.3"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.125",
    "@layerzerolabs/oapp-evm": "^0.3.2",
    "@layerzerolabs/oft-evm": "^3.2.0",
    "@openzeppelin/contracts": "^4.8.0"
  }
}
